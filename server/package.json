{
  "name": "substack-digest-server",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "author": "nexteacc",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:scheduler": "tsx watch src/scheduler.ts",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mv dist/server/src/* dist/ && rm -rf dist/server dist/shared",
    "start": "node dist/index.js",
    "start:scheduler": "node dist/scheduler.js",
    "job:dispatch-digests": "node dist/jobs/dispatch-digest-jobs.js",
    "job:run-digest-jobs": "node dist/jobs/run-digest-jobs.js"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.29",
    "@ai-sdk/openai-compatible": "^2.0.35",
    "@clerk/express": "^2.0.6",
    "ai": "^6.0.86",
    "bottleneck": "^2.19.5",
    "cors": "^2.8.5",
    "dotenv": "^17.3.1",
    "drizzle-orm": "^0.44.2",
    "express": "^5.1.0",
    "nanoid": "^5.1.6",
    "node-cron": "^4.0.7",
    "p-limit": "^7.3.0",
    "postgres": "^3.4.8",
    "rss-parser": "^3.13.0",
    "tsx": "^4.19.4",
    "turndown": "^7.2.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/cors": "^2.8.18",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "@types/node-cron": "^3.0.11",
    "@types/turndown": "^5.0.6",
    "drizzle-kit": "^0.31.4",
    "typescript": "~5.9.3"
  }
}
